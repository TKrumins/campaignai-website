{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/purchase", "destination": "/get-started", "permanent": false },
    { "source": "/for", "destination": "/get-started", "permanent": false },
    { "source": "/for/:slug*", "destination": "/get-started", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ]
}
